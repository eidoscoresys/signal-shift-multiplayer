{
  "name": "signal-shift",
  "version": "1.0.0-rc.3",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "wrangler dev --port 8787",
