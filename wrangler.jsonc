{
  "name": "signal-shift",
  "main": "server/worker.ts",
  "compatibility_date": "2025-10-14",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "233001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "233002",
      "simple": {
        "limit": 240,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "workers_dev": true
}
